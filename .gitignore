# 依赖
node_modules/

# 运行日志（*.log 盖不住轮转出来的 events.log.<时间戳>：
# 那个是 events.log 到体积上限后按 ISO 时间戳改名归档的，文件名里只有
# 数字和连字符，**扩展名不是 .log** → 必须显式挡，否则轮转一次脏一次 status）
events.log
events.log.*
*.log

# 运行时状态：指令队列落盘（已下发未回执），不进版本库
*.db
*.db-journal
*.db-wal
*.db-shm

# 🚨 含令牌（CLOUD_WS_TOKEN / CLOUD_VIEWER_TOKEN），绝不能进版本库
.env
.env.local
# 换 .env 时顺手留下的备份（同样是含令牌的明文），一并挡掉
# 事由：2026-10-06 现场有 .env.dev-placeholder-备份 逃过上面两条 → status 里能看见、`git add -A` 就会进去
.env.*备份
.env.*.bak
.env.*~

# 运行时状态
.pids/

# 装机台账（运行时数据，同 events.log 一样不进版本库）
assets/provision-log.jsonl

# 安装包产物（.exe/.msi/.zip 大文件可从源码重打，见 docs/打包说明，不入版本库）
assets/pkg/
# 本地归档：调试日志 / 一次性探针脚本（含运行痕迹），不进版本库
_archive/

# OTA 清单是每次发布生成的部署产物（含域名/URL/sha256），不进版本库；只留 .example
ota.json
# rc 通道清单同类（2026-10-22 补：发 rc.3 时发现 ota-rc.json 逃过上面的规则，
# 每次 publish --channel rc 都会脏一次 status；灰度 ota-gray.json 是人工 pin 的
# 配置性质且已入轨，保持 tracked 不一并忽略）
ota-rc.json
# 2026-11-02 渠道类转正（alpha 灰度 / beta 测试 / stable 正式）后的两个新清单：
# 同样是每次发布生成的部署产物（含域名/URL/sha256），一律不入库。
# ⚠️ ota-builds.json（构建注册表）相反 —— 它是**状态**，不入库就丢了晋升计时起点，
#    会让已发构建回到"刚发布"状态、stable 突然看不见老版本。它必须 tracked。
ota-alpha.json
ota-beta.json

# 设备报修台账（运行时数据，由 scripts/backup.mjs 备份；不入库）
repairs.json

# 多租户租户表（2026-11-02）：**运行时数据**，路径由 CLOUD_TENANTS_FILE 指定，
# 缺省落在仓库根的 tenants.json。内容是真实学校的 id / 显示名 / 启停状态 ⇒ 不入库。
# 事由：跑单测时忘了给 CLOUD_TENANTS_FILE，它真往仓库根写了一份，status 当场脏。
# 首次部署由 tenant.js 的 initTenants() 自动生成（含默认组织），不需要入库。
tenants.json

# 一次性调试脚本（非构建基础设施），不进版本库
scripts/_*.mjs
!scripts/_inspect-queue.mjs

# 本地 VoiceHub 替身（scripts/_local_voicehub_standin.js）运行时持久化状态，不入库
data/

# ── 2026-10-24 工作区整理：一次性探针/诊断/备份，本地可用但不入库 ──
# 运行时缓存与备份目录
__pycache__/
backups/
*.bak-*
# 一次性脚本（scripts/_*.py 为本地诊断；已入库的 _dev_broadcast_club_harness.py 不受影响）
scripts/_*.py
_bp-*.mjs
_vnc_*.mjs
diag-*.mjs
mock-*.mjs
