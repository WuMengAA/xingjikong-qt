# 构建产物
build/
shots/

# 运行日志
*.log

# ── 部署/装机产物（2026-10-04 补，都是 windeployqt 拷出来的运行时，别进版本库）──
# deploy/ 有 101M（Qt 运行时 DLL + qml 插件，72 个二进制），msi/ 是 34M 装机包。
# 一次 "git add ." 就会把 135M 产物塞进 .git，磁盘本来就 100% 满（剩 2.6G）。
# 这两样都随编译重新生成，进库只增不减、还必然分叉。
deploy/
msi/

# ── 出包产物（2026-10-06 补）──
# scripts/make-portable.mjs 产出 dist/pkg-<版本>/ 与 stelarith-viewer-portable-<版本>.zip，
# 一跑就是 400M（125M 的 zip + 272M 解压）。它完全能从 build/ 重新生成，进库只增不减。
# ⚠️ 同门的被控端仓库已经把 dist/stelarith-agent-setup.exe（67MB）提交进去了，
#    每次重打包再存一份 —— 那边的问题没动，但这边不要再犯同一个错。
dist/
_archive/*.log
_archive/*.out
_archive/*.bak
_archive/*.prev

# 编译中间产物
*.pdb
*.ilk
*.bak
*.prev
*.out

# 一次性调试/探针脚本（非构建基础设施），不进版本库
scripts/_*.py
scripts/_*.mjs
scripts/_*.ps1
!scripts/_build_viewer.py
!scripts/_linknew.py
