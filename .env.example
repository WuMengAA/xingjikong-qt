# 星集控云端（stelarith-cloud-ws）环境变量样例
# 用法（Node 18+ 内置，无需装依赖）：
#   node --env-file=.env src/index.js
# 复制本文件为 .env 后填真值；下面这些值只是样例，别直接用于生产。

# 云端监听端口（默认 8788）
CLOUD_WS_PORT=8788

# 被控端接入令牌：教室机上的 STE_QT_WS_TOKEN 必须与它一致
CLOUD_WS_TOKEN=<设备令牌，与教室机 agent.env 里的 STE_QT_WS_TOKEN 相同>

# 管理端（/ws/viewer）长期令牌：桌面管理端 stelarith-viewer-qt 的 STE_VIEWER_TOKEN 与它一致
CLOUD_VIEWER_TOKEN=<管理端令牌，桌面管理端用>

# 管理端短票据签名密钥：必须与站点 .env 里的 CLOUD_VIEWER_SECRET **完全相同**，
# 否则手机集控页会显示"云端拒绝鉴权"。不下发到浏览器。
CLOUD_VIEWER_SECRET=<站点与云端共用的票据密钥>

# 心跳与离线判定（PRD FR-STA-01：心跳 10s、30s 判离线）
#   教室机每 10s 发一次心跳；超过 30s 既没心跳也没帧 → 判定离线并踢掉连接。
#   掉电/拔网线时 TCP 不会立刻关闭，只靠 close 事件会出现"永远在线"的假绿。
CLOUD_HEARTBEAT_TIMEOUT_MS=30000
CLOUD_SWEEP_INTERVAL_MS=5000

# 事件流水落盘文件
CLOUD_EVENTS_FILE=events.log
# 体积轮转（2026-10-06 · 占用优化）：到 MAX_BYTES 就把当前 events.log 改名归档
# （events.log.<时间戳>）再重建一个空的，归档只留最近 KEEP_FILES 个，更老的删掉。
# 留痕照旧，但不会让一个日志文件把盘吃干。默认 10MB / 留 3 份；填 0 可关掉轮转。
CLOUD_EVENTS_MAX_BYTES=10485760
CLOUD_EVENTS_KEEP_FILES=3
# 最近多少条设备回执留在内存里（滚动窗口，超了淘汰最老的）。
# 回执查老账走 SQLite 的 /api/instructions/notice，不靠这张内存表，
# 所以窗口给宽松点也没成本，给紧了能压住长时间不重启的云端内存。
CLOUD_RESULT_KEEP=5000

# ── 管理台 /admin「用网站账号登录」（2026-10-06 · 一户通）────────────
# 三个一起填 = /admin 登录页出现「用网站账号登录」；少填任何一项都自动退回
# 老路（手敲 CLOUD_VIEWER_TOKEN），不会报错、不会禁用登录。
# STE_SITE_URL 要与站点 .env 的 PUBLIC_SITE_URL（或站点实际对外地址）一致，
# 云端会往它上面打 /oauth/token 与 /oauth/userinfo 换票。
STE_SITE_URL=<站点地址，如 https://xxx.xyz>
STE_OAUTH_CLIENT_ID=xingjikong_native
STE_OAUTH_CLIENT_SECRET=<站点 .env 里的 OAUTH_DESKTOP_SECRET，同一个值>

# 管理台票据有效期：默认 30 天（与桌面端一户通同口径），毫秒；上限也是 30 天。
CLOUD_ADMIN_TICKET_TTL_MS=2592000000
