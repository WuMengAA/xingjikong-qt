; 星集控被控端 · NSIS 安装程序（makensis / NSIS 3）
;
; 本文件是 installer.iss（Inno Setup 6）的 NSIS 等价实现，文件清单 / 安装目录 / 升级逻辑
; 与 installer.iss 逐条对齐。起因：本机构建环境没有 Inno Setup 编译器（ISCC.exe），
; 而 agent 自更新例程（src/main.cpp）对安装包同时尝试 /S（NSIS）与 /VERYSILENT（Inno），
; 两种静默参数都能被 NSIS 包消费，故 NSIS 是等价的发布产物。
;
; 版本号：复用 CMake 生成的 build\version.nsh（!define VER "..."），唯一真源＝
;   CMakeLists.txt 的 set(AGENT_VERSION ...)。不要在此手写第二份版本。
;
; 构建：makensis installer.nsi   （工作目录＝本文件所在目录）
;
; 设计要点（与 installer.iss 一致）：
;   1. 装机不收集云端地址/设备令牌（只给截图目录）。
;   2. 自启沿用 deploy\install-autostart.ps1（登录触发器计划任务，非 Windows Service）。
;   3. 安装目录固定 {autopf}\Stelarith，不允许改，卸载递归删才安全。
;   4. 升级前先停旧进程 + 禁用看门狗任务，装完再启用，避免 exe 被占用导致覆盖失败。

!include "build\version.nsh"
!define VERSION "${VER}"

Name "星集控被控端 ${VERSION}"
OutFile "dist\stelarith-agent-setup-${VERSION}.exe"
InstallDir "$PROGRAMFILES64\Stelarith"
RequestExecutionLevel admin
SetCompressor /SOLID lzma
CRCCheck on
XPStyle on

; 升级前：停旧进程 + 禁用看门狗（对应 Inno ssInstall）。必须在文件复制前执行，
; 否则运行中 exe 被占用 → 覆盖失败 → 升级 exit 1。
Function .onInit
  nsExec::ExecToLog 'powershell.exe -NoProfile -Command "Disable-ScheduledTask -TaskName ''StelarithAgentGuard'' -ErrorAction SilentlyContinue"'
  nsExec::ExecToLog 'powershell.exe -NoProfile -Command "Get-Process -Name stelarith-agent-qt -ErrorAction SilentlyContinue | Stop-Process -Force"'
  Sleep 800
FunctionEnd

Section "安装星集控被控端" SEC01
  SetOverwrite on
  SetOutPath "$INSTDIR"

  ; ── 运行时（build/：刚编出来的 exe + windeployqt 补全的 Qt）──
  File "build\stelarith-agent-qt.exe"
  File "build\Qt6*.dll"
  ; ── OpenSSL 3 运行库（libdatachannel 的 DTLS 链了 PG17 的 OpenSSL，windeployqt 不认）──
  File "build\libssl-3-x64.dll"
  File "build\libcrypto-3-x64.dll"
  ; ── Qt 插件目录（递归）──
  File /r "build\platforms"
  File /r "build\imageformats"
  File /r "build\iconengines"
  File /r "build\generic"
  File /r "build\networkinformation"
  File /r "build\styles"
  ; ── TLS 后端插件（必须三个齐全：certonly / schannel / openssl）──
  File /r "build\tls"
  File /r "build\resources"
  File /r "build\translations"
  File /r "build\position"
  ; ── 灵动岛 QML（app 的 island/Main.qml + Qt QML 运行时，整目录带）──
  File /r "build\qml"
  ; ── deploy/ 独有（构建不产出），点名取，不通杀 deploy\* ──
  File "deploy\D3Dcompiler_47.dll"
  File "deploy\opengl32sw.dll"
  File "deploy\install-autostart.ps1"
  File "deploy\agent.env.example"
  File "deploy\start-agent.bat"
  File "deploy\msi-post-install.cmd"
  File "deploy\stelarith-agent-guard.bat"
  File "deploy\stelarith-agent-guard.ps1"
  File "deploy\stelarith-agent-guard-hidden.vbs"

  ; ── 最小化 agent.env：仅当不存在时写（保护已绑定的云端地址/令牌不被覆盖）──
  IfFileExists "$INSTDIR\agent.env" +2 0
  FileOpen $0 "$INSTDIR\agent.env" w
  FileWrite $0 "rem Generated by installer. Bind this device via 'Stelarith account' in the tray menu.$\r$\n"
  FileWrite $0 "rem To rename this device, set STE_QT_NAME and restart the agent.$\r$\n"
  FileWrite $0 "set STE_QT_SHOT_DIR=$INSTDIR\shots$\r$\n"
  FileClose $0

  ; ── 写卸载程序 ──
  WriteUninstaller "$INSTDIR\Uninstall.exe"

  ; ── 快捷方式（所有用户）──
  SetShellVarContext all
  CreateDirectory "$SMPROGRAMS\星集控被控端"
  CreateShortcut "$SMPROGRAMS\星集控被控端\星集控被控端.lnk" "$INSTDIR\stelarith-agent-qt.exe"
  CreateShortcut "$SMPROGRAMS\星集控被控端\卸载 星集控被控端.lnk" "$INSTDIR\Uninstall.exe"
  CreateShortcut "$DESKTOP\星集控被控端.lnk" "$INSTDIR\stelarith-agent-qt.exe"

  ; ── 建登录触发器计划任务（逻辑在 ps1，-SkipCopy：文件已由安装器放好）──
  nsExec::ExecToLog 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$INSTDIR\install-autostart.ps1" -SkipCopy -Dest "$INSTDIR"'
  ; ── 重新启用看门狗（与 .onInit 里的禁用成对）──
  nsExec::ExecToLog 'powershell.exe -NoProfile -Command "Enable-ScheduledTask -TaskName ''StelarithAgentGuard'' -ErrorAction SilentlyContinue"'
SectionEnd

Section "Uninstall"
  ; 先禁用看门狗，再删任务，再杀进程（避免卸载后它每 10 分钟仍去拉已删除的 exe）
  nsExec::ExecToLog 'powershell.exe -NoProfile -Command "Disable-ScheduledTask -TaskName ''StelarithAgentGuard'' -ErrorAction SilentlyContinue"'
  nsExec::ExecToLog 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$INSTDIR\install-autostart.ps1" -Uninstall'
  nsExec::ExecToLog 'powershell.exe -NoProfile -Command "Get-Process -Name stelarith-agent-qt -ErrorAction SilentlyContinue | Stop-Process -Force"'

  SetShellVarContext all
  Delete "$SMPROGRAMS\星集控被控端\星集控被控端.lnk"
  Delete "$SMPROGRAMS\星集控被控端\卸载 星集控被控端.lnk"
  RMDir "$SMPROGRAMS\星集控被控端"
  Delete "$DESKTOP\星集控被控端.lnk"

  ; 删安装目录（固定 Stelarith，递归删才安全；前置于存在性判定防误删）
  IfFileExists "$INSTDIR\stelarith-agent-qt.exe" 0 +2
  RMDir /r "$INSTDIR"
SectionEnd
