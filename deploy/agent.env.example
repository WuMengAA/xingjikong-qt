rem Copy this file to agent.env and fill in TEST1 values.
rem Lines are plain "set KEY=VALUE" (this file is executed by start-agent.bat via call).
set STE_QT_WS_URL=ws://<cloud-host>:8788/ws/agent
set STE_QT_WS_TOKEN=<token-matching-cloud-CLOUD_WS_TOKEN>
set STE_QT_UID=TEST1
set STE_QT_SHOT_DIR=%~dp0shots
rem 心跳间隔（毫秒，可省，缺省 10000）。云端默认 30s 收不到心跳/帧就判定离线。
rem   注意：心跳是独立于画面帧的存活信号——将来上"按需拉流"省带宽后，
rem   没人看的机器不推帧，那时帧不能当存活依据，必须靠心跳。
set STE_QT_HEARTBEAT_MS=10000
